<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Jellyfin supports LAN HTTP. NetworkPolicy gates source requests and media streams so
         cleartext remains limited to private/local addresses. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Podium's own updates (D-99): a release downloaded from GitHub, handed to Android's installer
         (which asks the listener to confirm) once it's checked to be this app, signed by the same key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PodiumApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Podium Jellyfin"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podium">

        <!-- Portrait only (D-108): Podium is a device you hold upright in one hand, and it has no
             landscape arrangement to turn into. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signing in on the online service's own page (§6); never started from outside Podium.
             Turning, folding or resizing the phone keeps the page (and anything typed into it). -->
        <activity
            android:name=".WebSignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- What Android's installer says about an update (D-99); only the installer's own intent reaches it. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
